@@ -0,0 +1,68 @@
+import { Driver, ON } from '@kit.TestKit';
+import { getComponent } from './TestHelper';
+
+// 方法说明：查找指定可观测 ID 的组件，执行点击操作并等待界面进入空闲状态。
+export async function tapById(driver: Driver, id: string): Promise<void> {
+  await (await getComponent(driver, id)).click();
+  await driver.delayMs(400);
+}
+
+// 方法说明：点击首页或“我的”主 Tab，并等待对应页面完成切换。
+export async function switchTab(driver: Driver, tab: 'home' | 'mine'): Promise<void> {
+  await tapById(driver, tab === 'home' ? 'main-tab-home' : 'main-tab-mine');
+}
+
+// 方法说明：点击指定序号的精品内容卡片，用于进入对应的内容详情页。
+export async function tapContentCard(driver: Driver, index: number = 0): Promise<void> {
+  await tapById(driver, `premium-video-item-${index}`);
+}
+
+// 方法说明：在播放器尚未打开时点击首个内容卡片，并等待视频播放器根组件出现。
+export async function openPlayerPage(driver: Driver): Promise<void> {
+  const player = await driver.findComponent(ON.id('player-root'));
+  if (player === null) {
+    await tapContentCard(driver);
+  }
+  await tapById(driver, 'detail-recommend-item-0')
+}
+
+// 方法说明：在音频播放器尚未打开时依次进入音频详情并点击首集内容进行播放。
+export async function openAudioPlayerPage(driver: Driver): Promise<void> {
+  await tapById(driver, 'audio-story-item-0');
+  await tapById(driver, 'audio-detail-item-0');
+}
+
+// 方法说明：切换到“我的”主 Tab，并等待“我的”页面根组件稳定显示。
+export async function openMinePage(driver: Driver): Promise<void> {
+  await switchTab(driver, 'mine');
+}
+
+// 方法说明：进入“我的”页面后点击观看历史入口，并等待历史内容区显示。
+export async function openViewHistoryPage(driver: Driver): Promise<void> {
+  await openMinePage(driver);
+  await tapById(driver, 'common-service-history');
+}
+
+// 方法说明：切换到指定首页内容 Tab，并等待对应页面完成布局刷新。
+export async function switchHomeCategory(driver: Driver, index: number): Promise<void> {
+  await tapById(driver, `home-category-${index}`);
+  await driver.delayMs(500);
+}
+
+// 方法说明：滚动查找指定组件。
+export async function scrollToComponent(driver: Driver, componentId: string, ): Promise<void> {
+  const scrollableComponent = await driver.findComponent(ON.type('List'));
+  if (scrollableComponent) {
+    await scrollableComponent.scrollSearch(ON.id(componentId));
+    await driver.delayMs(500);
+  }
+}
+
+// 方法说明：滚动到指定内容分组，点击分组内的“更多”，并等待目标更多页内容容器出现。
+export async function openMorePage(driver: Driver, sectionId: string, pageContentId: string): Promise<void> {
+  await scrollToComponent(driver, sectionId);
+  const more = await driver.findComponent(ON.text('更多').within(ON.id(sectionId)));
+  await more.click();
+  await driver.delayMs(500);
+  await getComponent(driver, pageContentId);
+}
diff --git a/product/phone/src/ohosTest/ets/test/common/EducationAssertions.ets b/product/phone/src/ohosTest/ets/test/common/EducationAssertions.ets
