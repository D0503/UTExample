+  describe('PageSpacingLgXlFailToPassTest', () => {
+    let driver: Driver;
+    let bundleName: string;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+      bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+      await startAbility(driver, bundleName);
+      await expectBreakpointIn(driver, bundleName, ['lg', 'xl']);
+    })
+
+    afterAll(async () => {
+      await driver.waitForIdle(2000, 3000);
+    })
+
+    // 用例说明：在 lg/xl 断点下检查首页内容区，验证其距左侧导航栏和窗口右边界均为 32vp。
+    it('should_set_home_margin_32vp_on_lg_xl', Level.LEVEL1, async (done: Function) => {
+      try {
+        await marginFromNavigation(driver, bundleName, 'main-tab-home', 'hobby-section', 32);
+      } catch (error) {
+        console.error('should_set_home_margin_32vp_on_lg_xl error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：在 lg/xl 断点下检查首页内容区，验证页面外边距适配为 32vp。
+    it('should_set_home_sub_page_margin_32vp_on_lg_xl', Level.LEVEL1, async (done: Function) => {
+      try {
+        await tapById(driver, 'hobby-card-0');
+        await margin(driver, bundleName, 'video-card', 32);
+        await driver.pressBack();
+        await driver.delayMs(300);
+      } catch (error) {
+        console.error('should_set_home_sub_page_margin_32vp_on_lg_xl error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：在 lg/xl 断点下进入“我的”页面，验证内容区距左侧导航栏和窗口右边界均为 32vp。
+    it('should_set_mine_margin_32vp_on_lg_xl', Level.LEVEL1, async (done: Function) => {
+      try {
+        await openMinePage(driver);
+        await marginFromNavigation(driver, bundleName, 'main-tab-mine', 'education-mine-content', 32);
+      } catch (error) {
+        console.error('should_set_mine_margin_32vp_on_lg_xl error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：在 lg/xl 断点下进入浏览历史子页面，验证内容区外边距适配为 32vp。
+    it('should_set_sub_page_margin_32vp_on_lg_xl', Level.LEVEL1, async (done: Function) => {
+      try {
