index 0000000000000000000000000000000000000000..bdc2a0ae25e806433012fe18b10f717487c52382
--- /dev/null
+++ b/product/phone/src/ohosTest/ets/test/common/LayoutAssertHelper.ets
@@ -0,0 +1,84 @@
+import { Driver } from '@kit.TestKit';
+import { expect } from '@ohos/hypium';
+import { getBoundsInContainer, getVisibleBounds, Rect } from './TestHelper';
+
+const TOLERANCE_VP: number = 3;
+
+// 方法说明：断言组件的上下左右边界均未超出应用窗口的可视范围。
+export function expectInWindow(windowRect: Rect, rect: Rect): void {
+  expect(rect.left >= windowRect.left).assertTrue();
+  expect(rect.right <= windowRect.right).assertTrue();
+  expect(rect.top >= windowRect.top).assertTrue();
+  expect(rect.bottom <= windowRect.bottom).assertTrue();
+}
+
+// 方法说明：计算两个组件在水平和垂直方向的交集，并断言二者不存在面积重叠。
+export function expectNoOverlap(first: Rect, second: Rect): void {
+  const horizontal = Math.min(first.right, second.right) - Math.max(first.left, second.left);
+  const vertical = Math.min(first.bottom, second.bottom) - Math.max(first.top, second.top);
+  expect(horizontal <= 0 || vertical <= 0).assertTrue();
+}
+
+// 方法说明：断言内容区相对容器左右边界的间距均接近指定 vp 值。
+export function expectHorizontalMargin(container: Rect, content: Rect, expectedVp: number): void {
+  expect(Math.abs(px2vp(content.left - container.left) - expectedVp) <= TOLERANCE_VP).assertTrue();
+  expect(Math.abs(px2vp(container.right - content.right) - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言大屏内容区距左侧导航栏右边界和窗口右边界的间距均接近指定值。
+export function expectHorizontalMarginFromNavigation(windowRect: Rect, navigationRect: Rect, contentRect: Rect,
+  expectedVp: number): void {
+  expect(Math.abs(px2vp(contentRect.left - navigationRect.right) - expectedVp) <= TOLERANCE_VP).assertTrue();
+  expect(Math.abs(px2vp(windowRect.right - contentRect.right) - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言内容组件左边界相对容器左边界的缩进接近指定 vp 值。
+export function expectLeftInsetNear(container: Rect, content: Rect, expectedVp: number): void {
+  expect(Math.abs(px2vp(content.left - container.left) - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言第二个组件左边界与第一个组件右边界之间的间距接近指定值。
+export function expectGapNear(first: Rect, second: Rect, expectedVp: number): void {
+  expect(Math.abs(px2vp(second.left - first.right) - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：根据相邻网格项处于同一行或同一列，验证其水平或垂直间距接近指定值。
+export function expectGridGapNear(first: Rect, second: Rect, expectedVp: number): void {
+  const sameRow: boolean = Math.abs(px2vp(second.top - first.top)) <= TOLERANCE_VP;
+  const actualGapVp: number = sameRow ? px2vp(second.left - first.right) : px2vp(second.top - first.bottom);
+  expect(Math.abs(actualGapVp - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：将组件像素高度转换为 vp，并断言其与预期高度的误差不超过 3vp。
+export function expectHeightNear(rect: Rect, expectedVp: number): void {
+  expect(Math.abs(px2vp(rect.bottom - rect.top) - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：将组件像素宽度转换为 vp，并断言其与预期宽度的误差不超过 3vp。
+export function expectWidthNear(rect: Rect, expectedVp: number): void {
+  expect(Math.abs(px2vp(rect.right - rect.left) - expectedVp) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：统计首行可见组件数量，并断言响应式列表的实际列数等于预期值。
+export async function expectColumnCount(driver: Driver, itemIds: string[], expected: number): Promise<void> {
+  const rects = await getVisibleBounds(driver, itemIds);
+  expectRectsColumnCount(rects, expected);
+}
+
+// 方法说明：查找指定容器内的 GridItem，并断言其首行实际列数等于预期值。
+export async function expectColumnCountInContainer(driver: Driver, containerId: string,
+  expected: number): Promise<void> {
+  const rects = await getBoundsInContainer(driver, containerId, 'GridItem');
+  expectRectsColumnCount(rects, expected);
+}
+
+// 方法说明：根据一组有效组件边界统计首行元素数量，用于统一执行列数断言。
+function expectRectsColumnCount(rects: Rect[], expected: number): void {
+  expect(rects.length >= expected).assertTrue();
+  const firstTop = rects[0].top;
+  let count = 0;
+  for (const rect of rects) {
+    if (Math.abs(px2vp(rect.top - firstTop)) <= TOLERANCE_VP) count++;
+  }
+  expect(count).assertEqual(expected);
+}
diff --git a/product/phone/src/ohosTest/ets/test/common/TestHelper.ets b/product/phone/src/ohosTest/ets/test/common/TestHelper.ets
new file mode 100644
index 0000000000000000000000000000000000000000..162a22eefffac327aa3beae90ffb42df5b02d92f
--- /dev/null
+++ b/product/phone/src/ohosTest/ets/test/common/TestHelper.ets
@@ -0,0 +1,160 @@
+import { Want } from '@kit.AbilityKit';
+import { abilityDelegatorRegistry, Component, Driver, ON } from '@kit.TestKit';
+import { expect } from '@ohos/hypium';
+
+export interface Rect {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+// 方法说明：根据应用包名启动 EntryAbility，并等待界面完成首轮加载。
+export async function startAbility(driver: Driver, bundleName: string): Promise<void> {
+  const want: Want = { bundleName: bundleName, abilityName: 'EntryAbility' };
+  await abilityDelegatorRegistry.getAbilityDelegator().startAbility(want);
+  await driver.delayMs(2000);
+}
+
+// 方法说明：按可观测 ID 查找组件，并在组件不存在时立即使测试失败。
+export async function getComponent(driver: Driver, id: string): Promise<Component> {
+  const component = await driver.findComponent(ON.id(id));
+  expect(component !== null).assertTrue();
+  return component;
+}
+
+// 方法说明：按可观测 ID 尝试查找组件，查找失败时返回 null 而不中断用例。
+export async function tryGetComponent(driver: Driver, id: string): Promise<Component | null> {
+  try {
+    return await driver.findComponent(ON.id(id));
+  } catch (error) {
+    return null;
+  }
+}
+
+// 方法说明：在指定父容器内按可观测 ID 查找子组件，未找到时返回 null 供局部缺失断言使用。
+export async function tryGetComponentInContainer(driver: Driver, componentId: string,
+  containerId: string): Promise<Component | null> {
+  try {
+    return await driver.findComponent(ON.id(componentId).within(ON.id(containerId)));
+  } catch (error) {
+    return null;
+  }
+}
+
+// 方法说明：获取指定 ID 组件的上下左右像素边界，并转换为统一的 Rect 结构。
+export async function getBounds(driver: Driver, id: string): Promise<Rect> {
+  const component = await getComponent(driver, id);
+  const bounds = await component.getBounds();
+  return {
+    left: bounds.left as number,
+    top: bounds.top as number,
+    right: bounds.right as number,
+    bottom: bounds.bottom as number,
+  };
+}
+
+// 方法说明：批量获取指定 ID 列表中实际存在且宽高均大于零的组件边界。
+export async function getVisibleBounds(driver: Driver, ids: string[]): Promise<Rect[]> {
+  const result: Rect[] = [];
+  for (const id of ids) {
+    const component = await tryGetComponent(driver, id);
+    if (component !== null) {
+      const bounds = await component.getBounds();
+      const rect: Rect = {
+        left: bounds.left as number,
+        top: bounds.top as number,
+        right: bounds.right as number,
+        bottom: bounds.bottom as number,
+      };
+      if (rect.right > rect.left && rect.bottom > rect.top) {
+        result.push(rect);
+      }
+    }
+  }
+  return result;
+}
+
+// 方法说明：查找指定容器内某一类型的组件，并返回所有具有有效宽高的组件边界。
+export async function getBoundsInContainer(driver: Driver, containerId: string,
+  componentType: string): Promise<Rect[]> {
+  const components: Component[] = await driver.findComponents(ON.type(componentType).within(ON.id(containerId)));
+  const result: Rect[] = [];
+  for (const component of components) {
+    const bounds = await component.getBounds();
+    const rect: Rect = {
+      left: bounds.left as number,
+      top: bounds.top as number,
+      right: bounds.right as number,
+      bottom: bounds.bottom as number,
+    };
+    if (rect.right > rect.left && rect.bottom > rect.top) {
+      result.push(rect);
+    }
+  }
+  return result;
+}
+
+// 方法说明：按显示文本查找组件，并返回所有具有有效宽高的文本组件边界。
+export async function getVisibleBoundsByText(driver: Driver, text: string): Promise<Rect[]> {
+  const components: Component[] = await driver.findComponents(ON.text(text));
+  const result: Rect[] = [];
+  for (const component of components) {
+    const bounds = await component.getBounds();
+    const rect: Rect = {
+      left: bounds.left as number,
+      top: bounds.top as number,
+      right: bounds.right as number,
+      bottom: bounds.bottom as number,
+    };
+    if (rect.right > rect.left && rect.bottom > rect.top) {
+      result.push(rect);
+    }
+  }
+  return result;
+}
+
+// 方法说明：仅返回四条边均位于容器内且宽度大于 50vp 的组件 ID，排除边缘滑入项和异常小组件。
+export async function getVisibleIdsInContainer(driver: Driver, containerId: string, componentIds: string[]): Promise<string[]> {
+  const containerRect: Rect = await getBounds(driver, containerId);
+  const visibleIds: string[] = [];
+  for (const id of componentIds) {
+    const component = await tryGetComponent(driver, id);
+    if (component === null) {
+      continue;
+    }
+    const bounds = await component.getBounds();
+    const rect: Rect = {
+      left: bounds.left as number,
+      top: bounds.top as number,
+      right: bounds.right as number,
+      bottom: bounds.bottom as number,
+    };
+    const widthVp: number = px2vp(rect.right - rect.left);
+    if (widthVp > 50 && rect.left >= containerRect.left && rect.right <= containerRect.right &&
+      rect.top >= containerRect.top && rect.bottom <= containerRect.bottom) {
+      visibleIds.push(id);
+    }
+  }
+  return visibleIds;
+}
+
+// 方法说明：通过断言组件边界的宽度和高度均大于零来确认组件可见。
+export function expectVisible(rect: Rect): void {
+  expect(rect.right - rect.left).assertLarger(0);
+  expect(rect.bottom - rect.top).assertLarger(0);
+}
+
+// 方法说明：断言指定可观测 ID 的组件不存在于当前页面组件树中。
+export async function expectAbsent(driver: Driver, id: string): Promise<void> {
+  expect((await tryGetComponent(driver, id)) === null).assertTrue();
+}
+
+// 方法说明：根据前缀和数量生成从零开始编号的一组组件可观测 ID。
+export function ids(prefix: string, count: number): string[] {
+  const values: string[] = [];
+  for (let index = 0; index < count; index++) {
+    values.push(`${prefix}-${index}`);
+  }
+  return values;
+}
