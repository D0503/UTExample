@@ -0,0 +1,48 @@
+import { DisplayRotation, Driver } from '@kit.TestKit';
+import { expect } from '@ohos/hypium';
+import { Rect } from './TestHelper';
+
+// 方法说明：查找应用当前激活窗口并返回窗口在屏幕中的上下左右像素边界。
+export async function getWindowBounds(driver: Driver, bundleName: string): Promise<Rect> {
+  const win = await driver.findWindow({ bundleName: bundleName, active: true })
+  const bounds = await win.getBounds();
+  return {
+    left: bounds.left as number,
+    top: bounds.top as number,
+    right: bounds.right as number,
+    bottom: bounds.bottom as number,
+  };
+}
+
+// 方法说明：读取应用激活窗口的像素宽度，并将其转换为 vp 宽度。
+export async function getWindowVpWidth(driver: Driver, bundleName: string): Promise<number> {
+  const rect = await getWindowBounds(driver, bundleName);
+  return px2vp(rect.right - rect.left);
+}
+
+// 方法说明：根据窗口 vp 宽度按照 600、840、1440 三个阈值计算当前断点名称。
+export function getBreakpointName(widthVp: number): string {
+  if (widthVp < 600) return 'sm';
+  if (widthVp < 840) return 'md';
+  if (widthVp < 1440) return 'lg';
+  return 'xl';
+}
+
+// 方法说明：计算当前窗口断点，断言其属于预期断点集合并返回断点名称。
+export async function expectBreakpointIn(driver: Driver, bundleName: string, expected: string[]): Promise<string> {
+  const breakpoint = getBreakpointName(await getWindowVpWidth(driver, bundleName));
+  expect(expected.includes(breakpoint)).assertTrue();
+  return breakpoint;
+}
+
+// 方法说明：将测试设备旋转到横屏方向，并等待旋转后的布局完成刷新。
+export async function rotateToLandscape(driver: Driver): Promise<void> {
+  await driver.setDisplayRotation(DisplayRotation.ROTATION_0);
+  await driver.delayMs(600);
+}
+
+// 方法说明：将测试设备旋转到竖屏方向，并等待旋转后的布局完成刷新。
+export async function rotateToPortrait(driver: Driver): Promise<void> {
+  await driver.setDisplayRotation(DisplayRotation.ROTATION_90);
+  await driver.delayMs(600);
+}
diff --git a/product/phone/src/ohosTest/ets/test/common/EducationActionHelper.ets b/product/phone/src/ohosTest/ets/test/common/EducationActionHelper.ets
