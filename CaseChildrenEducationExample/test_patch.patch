+import { afterAll, beforeAll, describe, expect, it, Level } from '@ohos/hypium';
+import { abilityDelegatorRegistry, Driver } from '@kit.TestKit';
+import { JSON } from '@kit.ArkTS';
+import { startAbility } from '../common/TestHelper';
+import { insideWindow, noOverlap, visible } from '../common/EducationAssertions';
+import { openPlayerPage, switchTab, tapContentCard } from '../common/EducationActionHelper';
+
+// 方法说明：注册并执行 commonAllDevicePassToPassTest 测试套件。
+export default function commonAllDevicePassToPassTest() {
+  describe('AllDevicePassToPassTest', () => {
+    let driver: Driver;
+    let bundleName: string;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+      bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+      await startAbility(driver, bundleName);
+    })
+
+    afterAll(async () => {
+      await driver.waitForIdle(2000, 3000);
+    })
+
+    // 用例说明：启动被测 Ability，验证应用能够成功进入前台且无启动异常。
+    it('should_start_ability_successfully', Level.LEVEL1, async (done: Function) => {
+      try {
+        await visible(driver, 'education-home-root');
+      } catch (error) {
+        console.error('should_start_ability_successfully error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：启动应用后检查首页根容器，验证首页内容能够正常显示。
+    it('should_show_home_page_visible', Level.LEVEL1, async (done: Function) => {
+      try {
+        await visible(driver, 'education-home-content');
+        await insideWindow(driver, bundleName, 'education-home-content');
+        await insideWindow(driver, bundleName, 'premium-video-item-0');
+      } catch (error) {
+        console.error('should_show_home_page_visible error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：依次点击主导航标签，验证各主页面能够正常切换并显示。
+    it('should_switch_main_tabs_successfully', Level.LEVEL1, async (done: Function) => {
+      try {
+        await switchTab(driver, 'mine');
+        await visible(driver, 'education-mine-root');
+        await switchTab(driver, 'home');
+      } catch (error) {
+        console.error('should_switch_main_tabs_successfully error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：在各尺寸窗口下检查首页根容器，验证页面不存在横向溢出或被裁切。
+    it('should_keep_no_horizontal_overflow', Level.LEVEL1, async (done: Function) => {
+      try {
+        await noOverlap(driver, 'home-category-0', 'home-category-1');
+      } catch (error) {
+        console.error('should_keep_no_horizontal_overflow error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    // 用例说明：点击首页内容卡片，验证能够正常进入内容详情页或播放器页。
+    it('should_open_detail_or_player_from_content_card', Level.LEVEL1, async (done: Function) => {
+      try {
+        await tapContentCard(driver);
+        await visible(driver, 'content-detail-root');
+      } catch (error) {
+        console.error('should_open_detail_or_player_from_content_card error: ' + JSON.stringify(error));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+  })
+}
