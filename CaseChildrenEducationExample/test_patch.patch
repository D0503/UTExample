@@ -0,0 +1,193 @@
+import { Driver } from '@kit.TestKit';
+import { expect } from '@ohos/hypium';
+import { getWindowBounds } from './DeviceHelper';
+import {
+  getBounds,
+  getVisibleBounds,
+  getVisibleBoundsByText,
+  getVisibleIdsInContainer,
+  ids,
+  Rect,
+  tryGetComponent,
+  tryGetComponentInContainer
+} from './TestHelper';
+import {
+  expectColumnCount,
+  expectColumnCountInContainer,
+  expectGapNear,
+  expectGridGapNear,
+  expectHeightNear,
+  expectHorizontalMargin,
+  expectHorizontalMarginFromNavigation,
+  expectInWindow,
+  expectLeftInsetNear,
+  expectNoOverlap,
+  expectWidthNear,
+} from './LayoutAssertHelper';
+
+// 方法说明：获取指定组件边界，并断言组件具有有效宽度和高度以确认其可见。
+export async function visible(driver: Driver, id: string): Promise<void> {
+  const rect = await getBounds(driver, id);
+  expect(rect.right > rect.left && rect.bottom > rect.top).assertTrue();
+}
+
+// 方法说明：按业务文本查找至少一个具有有效宽高的组件，并断言该文本当前可见。
+export async function visibleText(driver: Driver, text: string): Promise<void> {
+  expect((await getVisibleBoundsByText(driver, text)).length > 0).assertTrue();
+}
+
+// 方法说明：断言指定业务文本不存在具有有效宽高的组件，用于验证相关区域已从可见布局中移除。
+export async function absentText(driver: Driver, text: string): Promise<void> {
+  const components = await driver.findComponents(ON.text(text));
+  expect(components === null).assertTrue();
+}
+
+// 方法说明：尝试查找指定可观测 ID，并断言该组件不存在于当前页面中。
+export async function absent(driver: Driver, id: string): Promise<void> {
+  expect((await tryGetComponent(driver, id)) === null).assertTrue();
+}
+
+// 方法说明：断言指定父容器内不存在目标子组件，用于区分重复 ID 在不同列表项中的显示状态。
+export async function absentInContainer(driver: Driver, componentId: string, containerId: string): Promise<void> {
+  expect((await tryGetComponentInContainer(driver, componentId, containerId)) === null).assertTrue();
+}
+
+// 方法说明：按 ID 前缀收集指定数量的列表项，并断言首行列数符合预期。
+export async function columns(driver: Driver, prefix: string, total: number, expected: number): Promise<void> {
+  await expectColumnCount(driver, ids(prefix, total), expected);
+}
+
+// 方法说明：查找指定页面容器内的 GridItem，并断言首行列数符合预期。
+export async function columnsInContainer(driver: Driver, containerId: string, expected: number): Promise<void> {
+  await expectColumnCountInContainer(driver, containerId, expected);
+}
+
+// 方法说明：获取应用窗口和内容区边界，并断言内容区左右页边距符合预期。
+export async function margin(driver: Driver, bundleName: string, contentId: string, expectedVp: number): Promise<void> {
+  expectHorizontalMargin(await getWindowBounds(driver, bundleName), await getBounds(driver, contentId), expectedVp);
+}
+
+// 方法说明：获取导航栏、内容区和窗口边界，并验证大屏主页面两侧间距符合预期。
+export async function marginFromNavigation(driver: Driver, bundleName: string, navigationId: string,
+  contentId: string, expectedVp: number): Promise<void> {
+  expectHorizontalMarginFromNavigation(await getWindowBounds(driver, bundleName), await getBounds(driver, navigationId),
+    await getBounds(driver, contentId), expectedVp);
+}
+
+// 方法说明：获取两个相邻组件的边界，并断言二者之间的水平间距符合预期。
+export async function gap(driver: Driver, firstId: string, secondId: string, expectedVp: number): Promise<void> {
+  expectGapNear(await getBounds(driver, firstId), await getBounds(driver, secondId), expectedVp);
+}
+
+// 方法说明：识别两个相邻网格项的排列方向，并验证对应的行间距或列间距符合预期。
+export async function gridGap(driver: Driver, firstId: string, secondId: string, expectedVp: number): Promise<void> {
+  expectGridGapNear(await getBounds(driver, firstId), await getBounds(driver, secondId), expectedVp);
+}
+
+// 方法说明：获取容器和内容组件边界，并断言内容相对容器的左侧缩进符合预期。
+export async function inset(driver: Driver, containerId: string, contentId: string, expectedVp: number): Promise<void> {
+  expectLeftInsetNear(await getBounds(driver, containerId), await getBounds(driver, contentId), expectedVp);
+}
+
+// 方法说明：获取指定组件边界，并断言其实际 vp 高度接近预期值。
+export async function height(driver: Driver, id: string, expectedVp: number): Promise<void> {
+  expectHeightNear(await getBounds(driver, id), expectedVp);
+}
+
+// 方法说明：获取指定组件边界，并断言其实际 vp 宽度接近预期值。
+export async function width(driver: Driver, id: string, expectedVp: number): Promise<void> {
+  expectWidthNear(await getBounds(driver, id), expectedVp);
+}
+
+// 方法说明：获取窗口和组件边界，并断言组件完整处于应用窗口可视范围内。
+export async function insideWindow(driver: Driver, bundleName: string, id: string): Promise<void> {
+  expectInWindow(await getWindowBounds(driver, bundleName), await getBounds(driver, id));
+}
+
+// 方法说明：比较组件底边与窗口底边的距离，并断言其不超过允许的 vp 误差。
+export async function atWindowBottom(driver: Driver, bundleName: string, id: string, expectedVp: number ): Promise<void> {
+  const windowRect: Rect = await getWindowBounds(driver, bundleName);
+  const componentRect: Rect = await getBounds(driver, id);
+  expect(Math.abs(px2vp(windowRect.bottom - componentRect.bottom)) <= expectedVp).assertTrue();
+}
+
+// 方法说明：断言组件底边距窗口底边至少一个自身高度，以排除底部停靠布局。
+export async function notAtWindowBottom(driver: Driver, bundleName: string, id: string): Promise<void> {
+  const windowRect: Rect = await getWindowBounds(driver, bundleName);
+  const componentRect: Rect = await getBounds(driver, id);
+  const componentHeight: number = componentRect.bottom - componentRect.top;
+  expect(windowRect.bottom - componentRect.bottom >= componentHeight).assertTrue();
+}
+
+// 方法说明：获取两个组件边界，并断言它们在页面布局中没有发生面积重叠。
+export async function noOverlap(driver: Driver, firstId: string, secondId: string): Promise<void> {
+  expectNoOverlap(await getBounds(driver, firstId), await getBounds(driver, secondId));
+}
+
+// 方法说明：比较两个组件的水平边界，并断言第二个组件完全位于第一个组件右侧。
+export async function rightOf(driver: Driver, leftId: string, rightId: string): Promise<void> {
+  const left: Rect = await getBounds(driver, leftId);
+  const right: Rect = await getBounds(driver, rightId);
+  expect(right.left >= left.right).assertTrue();
+}
+
+// 方法说明：断言至少一个可见文本组件完整位于指定组件右侧，用于验证无专用 ID 的侧栏布局。
+export async function textRightOf(driver: Driver, leftId: string, text: string): Promise<void> {
+  const left: Rect = await getBounds(driver, leftId);
+  const candidates: Rect[] = await getVisibleBoundsByText(driver, text);
+  expect(candidates.some((candidate: Rect) => candidate.left >= left.right)).assertTrue();
+}
+
+// 方法说明：断言组件右边界与应用窗口右边界之间预留的宽度接近指定 vp 值。
+export async function rightSpace(driver: Driver, bundleName: string, id: string, expectedVp: number): Promise<void> {
+  const windowRect: Rect = await getWindowBounds(driver, bundleName);
+  const componentRect: Rect = await getBounds(driver, id);
+  expect(Math.abs(px2vp(windowRect.right - componentRect.right) - expectedVp) <= 5).assertTrue();
+}
+
+// 方法说明：断言组件实际宽度小于应用窗口宽度，以确认大屏下为侧栏主动收缩内容区。
+export async function narrowerThanWindow(driver: Driver, bundleName: string, id: string): Promise<void> {
+  const windowRect: Rect = await getWindowBounds(driver, bundleName);
+  const componentRect: Rect = await getBounds(driver, id);
+  expect(componentRect.right - componentRect.left < windowRect.right - windowRect.left).assertTrue();
+}
+
+// 方法说明：断言组件横向填满应用窗口，且纵向仅允许保留系统安全区高度。
+export async function fillsWindow(driver: Driver, bundleName: string, id: string): Promise<void> {
+  const windowRect: Rect = await getWindowBounds(driver, bundleName);
+  const componentRect: Rect = await getBounds(driver, id);
+  expect(Math.abs(px2vp(componentRect.left - windowRect.left)) <= 3).assertTrue();
+  expect(Math.abs(px2vp(windowRect.right - componentRect.right)) <= 3).assertTrue();
+}
+
+// 方法说明：断言两个 Tab 靠窗口左侧对齐且上下排列，用于确认左侧竖向导航形态。
+export async function leftVerticalTabs(driver: Driver, bundleName: string, firstTabId: string,
+  secondTabId: string): Promise<void> {
+  const windowRect: Rect = await getWindowBounds(driver, bundleName);
+  const firstTab: Rect = await getBounds(driver, firstTabId);
+  const secondTab: Rect = await getBounds(driver, secondTabId);
+  expect(Math.abs(px2vp(firstTab.left - windowRect.left)) <= 3).assertTrue();
+  expect(Math.abs(px2vp(secondTab.left - windowRect.left)) <= 3).assertTrue();
+  expect(Math.abs(px2vp(firstTab.left - secondTab.left)) <= 3).assertTrue();
+  expect(secondTab.top >= firstTab.bottom).assertTrue();
+}
+
+// 方法说明：比较两个组件的垂直边界，并断言第二个组件完全位于第一个组件下方。
+export async function below(driver: Driver, topId: string, bottomId: string): Promise<void> {
+  const top: Rect = await getBounds(driver, topId);
+  const bottom: Rect = await getBounds(driver, bottomId);
+  expect(bottom.top >= top.bottom).assertTrue();
+}
+
+// 方法说明：按 ID 前缀统计具有有效边界的可见组件，并断言数量等于预期值。
+export async function visibleCount(driver: Driver, prefix: string, total: number, expected: number): Promise<void> {
+  expect((await getVisibleBounds(driver, ids(prefix, total))).length).assertEqual(expected);
+}
+
+// 方法说明：重复计算滚动容器中完全可见的组件 ID，避开轮播动画后断言稳定可见项数量。
+export async function visibleCountInContainer(driver: Driver, containerId: string, prefix: string, total: number,
+  expected: number): Promise<void> {
+  const actual = (await getVisibleIdsInContainer(driver, containerId, ids(prefix, total))).length;
+  await driver.delayMs(100);
+  expect(actual).assertEqual(expected);
+}
diff --git a/product/phone/src/ohosTest/ets/test/common/LayoutAssertHelper.ets b/product/phone/src/ohosTest/ets/test/common/LayoutAssertHelper.ets
