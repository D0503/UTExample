        return stress;
    }

    getSpecStress(specDesc) {
        let stress = 1;
        let suiteDesc = this.suiteService.getCurrentRunningSuite().description;
        let suites = ObjectUtils.get(this.data, SUITES_KEY, []);
        for (const suiteItem of suites) {
