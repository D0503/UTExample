+export const HW_LOGIN_TEXT: string = '华为账号一键登录';
+
+export const OTHER_LOGIN_TEXT: string = '其他方式登录';
+
+export const PHONE_INPUT_TEXT: string = '请输入账号';
+
+export const VERIFY_INPUT_TEXT: string = '短信验证码';
+
+export const LOGIN_TEXT: string = '登录';
+
+export const CHANNEL_TEXT: string = '微信';
+
+export const PRIVACY_TEXT: string = '《用户协议》';
+
+// 方法说明：连续返回直到登录示例首页出现。
+export async function returnToEntry(driver: Driver): Promise<void> {
+  for (let index = 0; index < 4; index++) {
+    if (await tryFindByText(driver, ENTRY_PAGE_TEXT) !== null) {
+      return;
+    }
+    await driver.pressBack();
+    await driver.delayMs(250);
+  }
+}
+
+// 方法说明：通过首页文字入口打开 LoginPage。
+export async function openLoginPage(driver: Driver): Promise<void> {
+  await returnToEntry(driver);
+  await (await findByText(driver, ENTRY_PAGE_TEXT)).click();
+  await driver.delayMs(500);
+}
+
+// 方法说明：通过首页文字入口打开 LoginSheet。
+export async function openLoginSheet(driver: Driver): Promise<void> {
+  await returnToEntry(driver);
+  await (await findByText(driver, ENTRY_SHEET_TEXT)).click();
+  await driver.delayMs(500);
+}
+
+// 方法说明：点击“其他方式登录”进入验证码登录形态。
+export async function openOtherLogin(driver: Driver): Promise<void> {
+  await (await findByText(driver, OTHER_LOGIN_TEXT)).click();
+  await driver.delayMs(250);
+}
+
+// 方法说明：使用匿名号码或绑定号码说明文字定位号码区域。
+export async function findAnonymousPhone(driver: Driver): Promise<Component> {
+  return findFirstText(driver, [PHONE_TEXT, PHONE_BINDING_TEXT]);
+}
+
+// 方法说明：按稳定 Image 类型定位登录应用图标。
+export async function findAppIcon(driver: Driver): Promise<Component> {
+  return findFirstByType(driver, 'Image');
+}
+
+// 方法说明：使用候选文字定位华为一键登录主按钮区域。
+export async function findPrimaryLoginButton(driver: Driver): Promise<Component> {
+  return findFirstText(driver, ['本机号码一键登录', '一键登录', PHONE_BINDING_TEXT]);
+}
