@@ -0,0 +1,38 @@
+import { expect } from '@ohos/hypium';
+import { abilityDelegatorRegistry, Driver } from '@kit.TestKit';
+import { normalizeRect, Rect } from './TestHelper';
+
+// 方法说明：获取当前被测应用活动窗口的 bounds。
+export async function getWindowBounds(driver: Driver): Promise<Rect> {
+  const bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+  const win = await driver.findWindow({ bundleName: bundleName, active: true });
+  return normalizeRect(await win.getBounds());
+}
+
+// 方法说明：根据窗口 vp 宽度计算 sm、md、lg 或 xl 断点。
+export function getBreakpointName(widthVp: number): string {
+  if (widthVp < 600) {
+    return 'sm';
+  }
+  if (widthVp < 840) {
+    return 'md';
+  }
+  if (widthVp < 1440) {
+    return 'lg';
+  }
+  return 'xl';
+}
+
+// 方法说明：断言当前窗口处于指定断点集合。
+export async function expectBreakpointIn(driver: Driver, expected: string[]): Promise<string> {
+  const windowRect = await getWindowBounds(driver);
+  const breakpoint = getBreakpointName(px2vp(windowRect.right - windowRect.left));
+  expect(expected.includes(breakpoint)).assertTrue();
+  return breakpoint;
+}
+
+// 方法说明：判断当前窗口是否为 Pura X 外屏一类高度不超过 400vp 的极低高度窗口。
+export async function isPuraXOuterHeight(driver: Driver): Promise<boolean> {
+  const windowRect = await getWindowBounds(driver);
+  return px2vp(windowRect.bottom - windowRect.top) <= 400;
+}
diff --git a/entry/src/ohosTest/ets/test/common/LayoutAssertHelper.ets b/entry/src/ohosTest/ets/test/common/LayoutAssertHelper.ets
new file mode 100644
index 0000000..77c46a2
--- /dev/null
+++ b/entry/src/ohosTest/ets/test/common/LayoutAssertHelper.ets
@@ -0,0 +1,41 @@
+import { expect } from '@ohos/hypium';
+import { Rect, rectWidth } from './TestHelper';
+
+const TOLERANCE_VP: number = 4;
+
+// 方法说明：断言内容完整位于指定容器内。
+export function expectInBounds(container: Rect, content: Rect): void {
+  expect(content.left >= container.left).assertTrue();
+  expect(content.right <= container.right).assertTrue();
+  expect(content.top >= container.top).assertTrue();
+  expect(content.bottom <= container.bottom).assertTrue();
+}
+
+// 方法说明：断言内容宽度不超过指定 vp 上限。
+export function expectWidthAtMost(rect: Rect, expectedVp: number): void {
+  expect(px2vp(rectWidth(rect)) <= expectedVp + TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言内容与容器水平中心基本重合。
+export function expectCentered(container: Rect, content: Rect): void {
+  const containerCenter = (container.left + container.right) / 2;
+  const contentCenter = (content.left + content.right) / 2;
+  expect(Math.abs(px2vp(containerCenter - contentCenter)) <= TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言内容左右至少保留指定边距。
+export function expectHorizontalEdgeSpaceAtLeast(container: Rect, content: Rect, expectedVp: number): void {
+  expect(px2vp(content.left - container.left) >= expectedVp - TOLERANCE_VP).assertTrue();
+  expect(px2vp(container.right - content.right) >= expectedVp - TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言内容左边缘与容器左边缘至少保留指定边距。
+export function expectLeftEdgeSpaceNear(container: Rect, content: Rect, expectedVp: number): void {
+  const leftSpaceVp = px2vp(content.left - container.left);
+  expect(leftSpaceVp >= expectedVp - TOLERANCE_VP).assertTrue();
+}
+
+// 方法说明：断言第二个组件位于第一个组件下方。
+export function expectBelow(first: Rect, second: Rect): void {
+  expect(second.top >= first.bottom - vp2px(TOLERANCE_VP)).assertTrue();
+}
