@@ -0,0 +1,54 @@
+import { expect } from '@ohos/hypium';
+import { Component, Driver } from '@kit.TestKit';
+import { getWindowBounds } from './DeviceHelper';
+import { boundsOf, expectVisible, findById, findFirstByType, tryFindById, tryFindByText } from './TestHelper';
+
+// 方法说明：按稳定 Scroll 类型获取登录组件内部滚动容器。
+export async function getLoginScroll(driver: Driver): Promise<Component> {
+  await driver.delayMs(500);
+  return findFirstByType(driver, 'Scroll');
+}
+
+// 方法说明：必要时滚动到底部，并按文字确认目标控件可见。
+export async function scrollUntilTextVisible(driver: Driver, text: string): Promise<Component> {
+  let component = await tryFindByText(driver, text);
+  if (component !== null) {
+    const initial = await boundsOf(component);
+    if (initial.right > initial.left && initial.bottom > initial.top) {
+      return component;
+    }
+  }
+  const scroll = await getLoginScroll(driver);
+  await scroll.scrollToBottom(1000);
+  await driver.delayMs(250);
+  component = await tryFindByText(driver, text);
+  expect(component !== null).assertTrue();
+  const found = component as Component;
+  expectVisible(await boundsOf(found));
+  return found;
+}
+
+// 方法说明：滚动登录组件后按稳定 ID 查找目标组件并验证其完整可见。
+export async function scrollUntilIdVisible(driver: Driver, id: string): Promise<Component> {
+  let component = await tryFindById(driver, id);
+  if (component !== null) {
+    const initialBounds = await boundsOf(component);
+    const windowBounds = await getWindowBounds(driver);
+    if (initialBounds.top >= windowBounds.top && initialBounds.bottom <= windowBounds.bottom) {
+      expectVisible(initialBounds);
+      return component;
+    }
+  }
+  const scroll = await getLoginScroll(driver);
+  await scroll.scrollToBottom(1000);
+  component = await findById(driver, id);
+  expectVisible(await boundsOf(component));
+  return component;
+}
+
+// 方法说明：将登录组件内部滚动容器恢复到顶部。
+export async function scrollBackToTop(driver: Driver): Promise<void> {
+  const scroll = await getLoginScroll(driver);
+  await scroll.scrollToTop(500);
+  await driver.delayMs(250);
+}
diff --git a/entry/src/ohosTest/ets/test/common/TestHelper.ets b/entry/src/ohosTest/ets/test/common/TestHelper.ets
new file mode 100644
index 0000000..a0535a8
--- /dev/null
+++ b/entry/src/ohosTest/ets/test/common/TestHelper.ets
@@ -0,0 +1,121 @@
+import { Want } from '@kit.AbilityKit';
+import { abilityDelegatorRegistry, Component, Driver, ON } from '@kit.TestKit';
+import { expect } from '@ohos/hypium';
+
+export interface Rect {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+// 方法说明：启动被测 EntryAbility，并等待首页完成渲染。
+export async function startAbility(driver: Driver): Promise<void> {
+  const want: Want = {
+    bundleName: abilityDelegatorRegistry.getArguments().bundleName,
+    abilityName: 'EntryAbility',
+  };
+  await abilityDelegatorRegistry.getAbilityDelegator().startAbility(want);
+  await driver.delayMs(500);
+}
+
+// 方法说明：按完整可见文字查找组件，找不到时使断言失败。
+export async function findByText(driver: Driver, text: string): Promise<Component> {
+  const component = await driver.findComponent(ON.text(text));
+  expect(component !== null).assertTrue();
+  return component;
+}
+
+// 方法说明：按稳定组件 ID 查找无法通过独立文字节点定位的组件。
+export async function findById(driver: Driver, id: string): Promise<Component> {
+  const component = await driver.findComponent(ON.id(id));
+  expect(component !== null).assertTrue();
+  return component;
+}
+
+// 方法说明：尝试按稳定组件 ID 查找组件，组件不存在或当前不可定位时返回 null。
+export async function tryFindById(driver: Driver, id: string): Promise<Component | null> {
+  try {
+    return await driver.findComponent(ON.id(id));
+  } catch (error) {
+    return null;
+  }
+}
+
+// 方法说明：尝试按文字查找组件，组件不存在时返回 null。
+export async function tryFindByText(driver: Driver, text: string): Promise<Component | null> {
+  try {
+    return await driver.findComponent(ON.text(text));
+  } catch (error) {
+    return null;
+  }
+}
+
+// 方法说明：按候选文字顺序返回第一个可定位组件。
+export async function findFirstText(driver: Driver, texts: string[]): Promise<Component> {
+  for (const text of texts) {
+    const component = await tryFindByText(driver, text);
+    if (component !== null) {
+      return component;
+    }
+  }
+  expect(false).assertTrue();
+  return driver.findComponent(ON.text(texts[0]));
+}
+
+// 方法说明：按稳定组件类型返回当前页面的第一个匹配组件。
+export async function findFirstByType(driver: Driver, type: string): Promise<Component> {
+  const components = await driver.findComponents(ON.type(type));
+  expect(components.length).assertLarger(0);
+  return components[0];
+}
+
+// 方法说明：先按组件类型筛选，再根据组件文本返回精确匹配项。
+export async function findByTypeAndText(driver: Driver, type: string, text: string): Promise<Component> {
+  const components = await driver.findComponents(ON.type(type));
+  for (const component of components) {
+    if (await component.getText() === text) {
+      return component;
+    }
+  }
+  expect(false).assertTrue();
+  return driver.findComponent(ON.type(type));
+}
+
+// 方法说明：将 TestKit bounds 转换为统一矩形结构。
+export function normalizeRect(bounds: ESObject): Rect {
+  return {
+    left: bounds.left as number,
+    top: bounds.top as number,
+    right: bounds.right as number,
+    bottom: bounds.bottom as number,
+  };
+}
+
+// 方法说明：读取组件 bounds 并转换为统一矩形结构。
+export async function boundsOf(component: Component): Promise<Rect> {
+  return normalizeRect(await component.getBounds());
+}
+
+// 方法说明：计算矩形宽度。
+export function rectWidth(rect: Rect): number {
+  return rect.right - rect.left;
+}
+
+// 方法说明：计算矩形高度。
+export function rectHeight(rect: Rect): number {
+  return rect.bottom - rect.top;
+}
+
+// 方法说明：断言矩形具有有效宽高。
+export function expectVisible(rect: Rect): void {
+  expect(rectWidth(rect)).assertLarger(0);
+  expect(rectHeight(rect)).assertLarger(0);
+}
+
+// 方法说明：按文字查找组件并断言其可见。
+export async function expectTextVisible(driver: Driver, text: string): Promise<Rect> {
+  const rect = await boundsOf(await findByText(driver, text));
+  expectVisible(rect);
+  return rect;
+}
