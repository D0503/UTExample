@@ -0,0 +1,26 @@
+import { afterAll, beforeAll, describe, it, Level } from '@ohos/hypium';
+import { Driver } from '@kit.TestKit';
+import { expectTextVisible, startAbility } from '../common/TestHelper';
+import { ENTRY_PAGE_TEXT, ENTRY_SHEET_TEXT } from '../common/LoginActionHelper';
+
+// 套件说明：保护所有断点下两个登录入口均可被用户发现。
+export default function allBreakpointPassToPassTest(): void {
+  describe('AllBreakpointPassToPassTest', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+      await startAbility(driver);
+    })
+
+    afterAll(async () => {
+      await driver.delayMs(500);
+    })
+
+    // 用例说明：验证首页同时提供 Page 和 Sheet 两个文字入口。
+    it('should_show_page_and_sheet_entries', Level.LEVEL0, async () => {
+      await expectTextVisible(driver, ENTRY_PAGE_TEXT);
+      await expectTextVisible(driver, ENTRY_SHEET_TEXT);
+    })
