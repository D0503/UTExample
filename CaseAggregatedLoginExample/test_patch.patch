@@ -0,0 +1,95 @@
+import { Driver } from '@kit.TestKit';
+import { boundsOf, expectVisible, findById, findByText, findByTypeAndText } from './TestHelper';
+import { getWindowBounds } from './DeviceHelper';
+import { expectCentered, expectWidthAtMost } from './LayoutAssertHelper';
+import {
+  CHANNEL_TEXT,
+  findAnonymousPhone,
+  findAppIcon,
+  findPrimaryLoginButton,
+  openLoginPage,
+  openLoginSheet,
+  openOtherLogin,
+  OTHER_LOGIN_TEXT,
+  PRIVACY_TEXT
+} from './LoginActionHelper';
+import { getLoginScroll, scrollUntilIdVisible, scrollUntilTextVisible } from './ScrollAssertHelper';
+
+// 方法说明：按 Page/Sheet 和主登录/其他登录参数准备测试页面。
+export async function prepareLogin(driver: Driver, sheet: boolean, other: boolean, needScroll: boolean = false): Promise<void> {
+  if (sheet) {
+    await openLoginSheet(driver);
+  } else {
+    await openLoginPage(driver);
+  }
+  if (other) {
+    if (needScroll) {
+      const scroll = await getLoginScroll(driver);
+      await scroll.scrollToBottom(1000);
+      await driver.delayMs(250);
+    }
+    await openOtherLogin(driver);
+  }
+}
+
+// 方法说明：验证华为登录形态的全部关键控件可通过滚动到达。
+export async function expectPrimaryControlsReachable(driver: Driver): Promise<void> {
+  expectVisible(await boundsOf(await findAppIcon(driver)));
+  expectVisible(await boundsOf(await findAnonymousPhone(driver)));
+  await scrollUntilTextVisible(driver, OTHER_LOGIN_TEXT);
+  await scrollUntilIdVisible(driver, 'agree-privacy-box');
+}
+
+// 方法说明：验证其他登录形态的输入、按钮、渠道和协议均可达。
+export async function expectOtherUpperControlsReachable(driver: Driver): Promise<void> {
+  expectVisible(await boundsOf(await findAppIcon(driver)));
+  await scrollUntilIdVisible(driver, 'phone-input');
+}
+
+// 方法说明：验证其他登录形态的输入、按钮、渠道和协议均可达。
+export async function expectOtherDownControlsReachable(driver: Driver): Promise<void> {
+  await scrollUntilIdVisible(driver, 'verify-login-button');
+  expectVisible(await boundsOf(await findByText(driver, CHANNEL_TEXT)));
+  expectVisible(await boundsOf(await findById(driver, 'agree-privacy-box')));
+}
+
+// 方法说明：不执行滚动，验证华为登录形态的全部关键控件均在首屏可见。
+export async function expectPrimaryControlsVisibleWithoutScroll(driver: Driver): Promise<void> {
+  expectVisible(await boundsOf(await findAppIcon(driver)));
+  expectVisible(await boundsOf(await findAnonymousPhone(driver)));
+  expectVisible(await boundsOf(await findPrimaryLoginButton(driver)));
+  expectVisible(await boundsOf(await findByText(driver, OTHER_LOGIN_TEXT)));
+  expectVisible(await boundsOf(await findById(driver, 'agree-privacy-box')));
+}
+
+// 方法说明：不执行滚动，验证其他登录形态的全部关键控件均在首屏可见。
+export async function expectOtherControlsVisibleWithoutScroll(driver: Driver): Promise<void> {
+  expectVisible(await boundsOf(await findAppIcon(driver)));
+  expectVisible(await boundsOf(await findById(driver, 'phone-input')));
+  expectVisible(await boundsOf(await findById(driver, 'verify-code-input')));
+  expectVisible(await boundsOf(await findById(driver, 'verify-login-button')));
+  expectVisible(await boundsOf(await findByText(driver, CHANNEL_TEXT)));
+  expectVisible(await boundsOf(await findById(driver, 'agree-privacy-box')));
+}
+
+// 方法说明：按文字定位组件并验证 448vp 限宽和水平居中。
+export async function expectTextLimitedAndCentered(driver: Driver, text: string): Promise<void> {
+  const content = await boundsOf(await findByText(driver, text));
+  expectWidthAtMost(content, 448);
+  expectCentered(await getWindowBounds(driver), content);
+}
+
+// 方法说明：按组件类型和文字定位外层组件，并验证 448vp 限宽和水平居中。
+export async function expectTypedComponentLimitedAndCentered(driver: Driver, type: string,
+  text: string): Promise<void> {
+  const content = await boundsOf(await findByTypeAndText(driver, type, text));
+  expectWidthAtMost(content, 448);
+  expectCentered(await getWindowBounds(driver), content);
+}
+
+// 方法说明：按稳定 ID 定位外层组件，并验证 448vp 限宽和水平居中。
+export async function expectIdComponentLimitedAndCentered(driver: Driver, id: string): Promise<void> {
+  const content = await boundsOf(await findById(driver, id));
+  expectWidthAtMost(content, 448);
+  expectCentered(await getWindowBounds(driver), content);
+}
