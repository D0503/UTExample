+import { isPuraXOuterHeight } from '../common/DeviceHelper';
+import { findAppIcon, openOtherLogin } from '../common/LoginActionHelper';
+import {
+  expectOtherDownControlsReachable,
+  expectOtherUpperControlsReachable,
+  expectPrimaryControlsReachable,
+  prepareLogin
+} from '../common/LoginScenarioHelper';
+import { getLoginScroll, scrollBackToTop, scrollUntilIdVisible } from '../common/ScrollAssertHelper';
+import { boundsOf, expectVisible, startAbility } from '../common/TestHelper';
+
+// 套件说明：验证 Pura X 外屏极低高度 Page 的内部滚动适配。
+export default function puraXOuterPageFailToPassTest(): void {
+  describe('PuraXOuterPageFailToPassTest', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+      await startAbility(driver);
+      if (!(await isPuraXOuterHeight(driver))) {
+        expect(false).assertTrue();
+      }
+    })
+
+    afterAll(async () => {
+      await driver.delayMs(250);
+    })
+
+    // 用例说明：Pura X 外屏华为登录 Page 可滚动到全部关键控件。
+    it('should_reach_all_primary_page_controls_by_scroll_on_pura_x_outer', Level.LEVEL1, async () => {
+      await prepareLogin(driver, false, false);
+      await expectPrimaryControlsReachable(driver);
+    })
+
+    // 用例说明：Pura X 外屏其他登录 Page 可滚动到上半部分关键控件。
+    it('should_reach_up_other_page_controls_by_scroll_on_pura_x_outer', Level.LEVEL1, async () => {
+      await prepareLogin(driver, false, true, true);
+      await driver.delayMs(300);
+      await expectOtherUpperControlsReachable(driver);
+    })
+
+    // 用例说明：Pura X 外屏其他登录 Page 可滚动到下半部分关键控件。
+    it('should_reach_down_other_page_controls_by_scroll_on_pura_x_outer', Level.LEVEL1, async () => {
+      const scroll = await getLoginScroll(driver);
+      await scroll.scrollToBottom(1000);
+      await openOtherLogin(driver);
+      await expectOtherDownControlsReachable(driver);
+    })
+
+    // 用例说明：Pura X 外屏 Page 滚动到底后可以返回顶部。
+    it('should_scroll_back_to_page_top_on_pura_x_outer', Level.LEVEL1, async () => {
+      await prepareLogin(driver, false, false);
+      await scrollUntilIdVisible(driver, 'agree-privacy-box');
+      await scrollBackToTop(driver);
+      expectVisible(await boundsOf(await findAppIcon(driver)));
+    })
+  })
+}
